{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoLang",
  "version": "0.1.0",
  "identifier": "com.max.neolang",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NeoLang",
        "width": 800,
        "height": 600,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": {
      "dmg": {
        "background": "../src/assets/background.png"
      }
    },
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26,
      "versionCode": 1000
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
